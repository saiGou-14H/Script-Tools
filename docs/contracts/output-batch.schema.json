{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Tools output batch 2.0",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "2.0"
    },
    "batch_key": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
    },
    "phase": {
      "enum": [
        "ACTION",
        "OUTPUT_HOOK"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "output_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "producer_outcome": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED"
      ]
    },
    "producer_error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    },
    "output_series_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "value": {},
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "value",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "reason": {
      "enum": [
        "explicit",
        "interval",
        "checkpoint",
        "final"
      ]
    }
  },
  "required": [
    "protocol_version",
    "batch_key",
    "phase",
    "outputs",
    "producer_outcome",
    "producer_error",
    "output_series_id",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "producer_outcome": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "producer_error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "producer_error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
