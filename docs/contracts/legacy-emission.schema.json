{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Tools local output handoff 1.0",
  "type": "object",
  "properties": {
    "adapter_protocol_version": {
      "const": "1.0"
    },
    "batch_key": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_key": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "output_key",
          "path",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 1
    }
  },
  "required": [
    "adapter_protocol_version",
    "batch_key",
    "files"
  ],
  "additionalProperties": false
}
