{
  "schema_version": "2.0",
  "script_id": "continuous-feed-demo",
  "version": "2.0.0",
  "language": "python",
  "entrypoint": "main.py",
  "integration_mode": "hooks",
  "hook_protocol_version": "2.0",
  "default_action": "watch_records",
  "actions": {
    "watch_records": {
      "handler": "watch_records",
      "side_effects": "read_only",
      "resume_handler": "resume_watch",
      "checkpoint_schema": {
        "type": "object",
        "required": [
          "cursor"
        ],
        "properties": {
          "cursor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": [
          "stopped"
        ],
        "properties": {
          "stopped": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "output_contract": {
        "required_keys": [
          "summary",
          "notice"
        ],
        "required_scope": "batch",
        "allowed_kinds": [
          "text",
          "message"
        ],
        "max_items": 100
      }
    }
  },
  "hooks": {
    "on_outputs": "produce_report",
    "on_cleanup": "cleanup"
  },
  "dependencies_lock": "requirements.lock",
  "credential_requirements": [],
  "network_requirements": {
    "mode": "HTTP",
    "domains": [
      "api.example.invalid"
    ],
    "methods": [
      "GET"
    ]
  },
  "supported_execution_modes": [
    "docker",
    "qemu_kvm",
    "qemu_tcg"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "source_url"
    ],
    "properties": {
      "source_url": {
        "type": "string",
        "format": "uri"
      }
    },
    "additionalProperties": false
  },
  "events": {},
  "extensions": []
}
