{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Tools result 2.0",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
    },
    "outcome": {
      "enum": [
        "COMPLETED",
        "ACTION_REQUIRED",
        "ERROR"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "data": {},
    "action_required": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "INPUT_UPDATE",
                "CREDENTIAL_UPDATE",
                "EXTERNAL_ACTION",
                "MANUAL_RESOLUTION"
              ]
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "resume_action": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "reason",
            "instructions",
            "expires_at",
            "resume_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            },
            "details": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "output_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "uniqueItems": true
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "attempt_id",
    "invocation_id",
    "action",
    "outcome",
    "data",
    "action_required",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "action_required": {
            "type": "null"
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ACTION_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "action_required": {
            "type": "object",
            "properties": {
              "reason": {
                "enum": [
                  "INPUT_UPDATE",
                  "CREDENTIAL_UPDATE",
                  "EXTERNAL_ACTION",
                  "MANUAL_RESOLUTION"
                ]
              },
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "resume_action": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "reason",
              "instructions",
              "expires_at",
              "resume_action"
            ],
            "additionalProperties": false
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "action_required": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "maxLength": 1000
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
