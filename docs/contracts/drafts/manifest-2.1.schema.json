{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Script Tools manifest 2.1 draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.1"
    },
    "script_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_+-]{0,31}$"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$"
    },
    "integration_mode": {
      "enum": [
        "hooks",
        "legacy"
      ]
    },
    "hook_protocol_version": {
      "const": "2.0"
    },
    "default_action": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "hooks": {
      "type": "object",
      "properties": {
        "on_init": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "validate_input": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "before_action": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "after_action": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "on_error": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "on_cleanup": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "on_outputs": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "dependencies_lock": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$"
    },
    "credential_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "network_requirements": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "HTTP",
            "BROKER",
            "PROXY"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "methods": {
          "type": "array",
          "items": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "mode",
        "domains",
        "methods"
      ],
      "additionalProperties": false
    },
    "supported_execution_modes": {
      "type": "array",
      "items": {
        "enum": [
          "docker",
          "qemu_kvm",
          "qemu_tcg"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "input_schema": {
      "$ref": "#/$defs/jsonSchema"
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "data_schema": {
            "$ref": "#/$defs/jsonSchema"
          }
        },
        "required": [
          "data_schema"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "config": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "runtime_spec": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+(?:/[^/\\\\:\\u0000-\\u001f]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "script_id",
    "version",
    "language",
    "entrypoint",
    "integration_mode",
    "default_action",
    "actions",
    "dependencies_lock",
    "credential_requirements",
    "network_requirements",
    "supported_execution_modes",
    "input_schema",
    "runtime_spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonSchema": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "side_effects": {
          "enum": [
            "read_only",
            "external_write",
            "unknown"
          ]
        },
        "input_schema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "output_schema": {
          "$ref": "#/$defs/jsonSchema"
        },
        "resume_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
          },
          "uniqueItems": true
        },
        "output_contract": {
          "type": "object",
          "properties": {
            "required_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,127}$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "allowed_kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "text",
                  "json",
                  "file",
                  "message"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required_scope": {
              "enum": [
                "batch",
                "final"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "resume_handler": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "checkpoint_schema": {
          "$ref": "#/$defs/jsonSchema"
        }
      },
      "required": [
        "side_effects"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "resume_handler": [
          "checkpoint_schema"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "integration_mode": {
            "const": "hooks"
          }
        }
      },
      "then": {
        "required": [
          "hook_protocol_version"
        ],
        "properties": {
          "actions": {
            "additionalProperties": {
              "required": [
                "handler",
                "output_schema"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "actions": {
            "maxProperties": 1
          },
          "hooks": {
            "maxProperties": 0
          }
        }
      }
    }
  ]
}
