HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:5174
# Set DATABASE_URL for a PostgreSQL server. An empty value selects local PGlite.
DATABASE_URL=
LOCAL_DATA_DIRECTORY=.local/database
DEV_SEED=true
# Base64-encoded 32-byte key for encrypted command receipts outside local development.
PAYLOAD_ENCRYPTION_KEY=
